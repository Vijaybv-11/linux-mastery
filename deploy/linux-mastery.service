[Unit]
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/linux-mastery
ExecStart=/usr/bin/python3 server.py --port 5273 --public-origin https://linux-mastery.abacusai.cloud
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
